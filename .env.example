TELEGRAM_BOT_TOKEN=replace_with_botfather_token
TELEGRAM_ALLOWED_USERS=123456789
GEMINI_API_KEY=replace_with_google_ai_studio_key
GEMINI_MODEL=gemini-2.5-flash
GITHUB_TOKEN=replace_with_github_pat
GITHUB_REPO=owner/repository
DEFAULT_BRANCH=main
AGENT_WORKING_BRANCH=agent-builds

# Automatically create a new private GitHub repo for new-project requests.
GITHUB_AUTO_CREATE_REPOSITORIES=true
GITHUB_NEW_REPO_PRIVATE=true

# Vercel project is found/created per GitHub repository.
VERCEL_TOKEN=replace_with_vercel_access_token
VERCEL_PROJECT_ID=
VERCEL_PROJECT_NAME=
VERCEL_TEAM_ID=
VERCEL_TARGET=production
VERCEL_PREVIEW_TARGET=preview
VERCEL_AUTO_CREATE_PROJECT=true
AUTO_PROMOTE_PRODUCTION=true
VERCEL_SMOKE_TEST_ENABLED=true
VERCEL_SMOKE_TEST_PATH=/
VERCEL_SYNC_ENV_KEYS=
VERCEL_ENV_TARGETS=production,preview
VERCEL_DEPLOY_TIMEOUT_SECONDS=900
VERCEL_POLL_INTERVAL_SECONDS=8
MAX_DEBUG_ATTEMPTS=2

# Durable memory/project registry and encrypted Telegram credentials.
ARJUN_STATE_DB_PATH=data/arjun.sqlite3
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ARJUN_SECRET_KEY=replace_with_a_generated_fernet_key
ARJUN_QUESTION_TIMEOUT_SECONDS=900
